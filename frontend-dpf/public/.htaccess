<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Ignore API routes if any
    RewriteCond %{REQUEST_URI} ^/api/ [NC]
    RewriteRule ^ - [L]

    # If the file or directory exists (e.g. assets, images), serve it directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Otherwise, redirect all requests to index.php (NOT index.html) to inject OG tags
    RewriteRule ^ index.php [L]
</IfModule>
